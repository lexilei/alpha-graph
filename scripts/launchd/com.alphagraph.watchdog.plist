<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- LaunchDaemon, NOT Agent: this box auto-logs-in as a different user,
       so user-level agents never load after a reboot. A daemon starts at
       boot regardless, as leizhihan, and revives the whole pipeline via
       the watchdog (which owns all 10 workers; never launchd-manage the
       workers directly - double management corrupts append-mode gzip).
       Install:
         sudo cp scripts/launchd/com.alphagraph.watchdog.plist /Library/LaunchDaemons/
         sudo launchctl bootstrap system /Library/LaunchDaemons/com.alphagraph.watchdog.plist -->
  <key>Label</key><string>com.alphagraph.watchdog</string>
  <key>UserName</key><string>leizhihan</string>
  <key>ProgramArguments</key><array>
    <string>/Users/leizhihan/Lex/alpha-graph/.venv/bin/python</string>
    <string>/Users/leizhihan/Lex/alpha-graph/scripts/watchdog.py</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/leizhihan/Lex/alpha-graph</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
  </dict>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/leizhihan/Lex/alpha-graph/data/logs/launchd/watchdog.log</string>
  <key>StandardErrorPath</key><string>/Users/leizhihan/Lex/alpha-graph/data/logs/launchd/watchdog.err</string>
</dict></plist>
