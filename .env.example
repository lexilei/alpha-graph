# SEC EDGAR requires a user-agent string with your name and email
SEC_EDGAR_USER_AGENT="FirstName LastName your@email.com"

# Finnhub API key (free tier: https://finnhub.io/register)
FINNHUB_API_KEY="your_finnhub_api_key"

# LLM provider — works with any OpenAI-compatible API
# Together AI example:
LLM_API_KEY="your_together_api_key"
LLM_BASE_URL="https://api.together.xyz/v1"
LLM_MODEL="meta-llama/Llama-3.3-70B-Instruct-Turbo"

# OpenAI example (leave LLM_BASE_URL empty):
# LLM_API_KEY="your_openai_api_key"
# LLM_BASE_URL=""
# LLM_MODEL="gpt-4o-mini"

# Alpaca API keys (paper trading: https://app.alpaca.markets/signup)
ALPACA_API_KEY="your_alpaca_api_key"
ALPACA_SECRET_KEY="your_alpaca_secret_key"
